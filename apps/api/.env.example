# Database - Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5433/financeapp?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5433/financeapp?schema=public"

# JWT Secrets (generate your own for production)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
JWT_REFRESH_SECRET=another-super-secret-refresh-key-minimum-32-characters
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# App Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Email
# Local: SMTP (Gmail, usa una "contraseña de aplicación"). Sin claves de Brevo/Resend se usa SMTP.
# Producción (Render): EMAIL_PROVIDER=resend + RESEND_API_KEY (Render bloquea SMTP).
# EMAIL_PROVIDER=disabled desactiva los correos.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-email@gmail.com

# EMAIL_PROVIDER=resend
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM="FinanceApp" <noreply@yourdomain.com>
# EMAIL_FROM="FinanceApp" <noreply@yourdomain.com>
